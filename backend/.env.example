# Database (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://debugdiary:debugdiary@localhost:5432/debugdiary"

# JWT — change this in production!
JWT_SECRET="debugdiary-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# AI (optional for Phase 1 — needed for AI extraction later)
GEMINI_API_KEY=""

# GitHub Webhook (optional — for verifying signed GitHub payloads)
GITHUB_WEBHOOK_SECRET=""

# Server
PORT=5000
NODE_ENV="development"
