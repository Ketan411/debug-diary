# Database (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://debugdiary:debugdiary@localhost:5432/debugdiary"

# JWT — change this in production!
JWT_SECRET="debugdiary-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Open-Source LLM Configuration (e.g. Groq, Ollama, vLLM, LM Studio)
LLM_BASE_URL="https://api.groq.com/openai/v1" # Or http://localhost:11434/v1 for local Ollama
LLM_API_KEY=""                                # Your Groq API key, or "ollama" for local
LLM_MODEL="llama-3.3-70b-versatile"          # Or qwen2.5-coder:7b / llama3.1-8b-instant

# GitHub Webhook (optional — for verifying signed GitHub payloads)
GITHUB_WEBHOOK_SECRET=""

# Server
PORT=5000
NODE_ENV="development"
